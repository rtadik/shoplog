{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@schema/*": ["schema/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "schema/**/*.ts",
    "scripts/**/*.ts",
    "electron.vite.config.ts"
  ]
}
